{
    "name": "AI Research Agent",
    "image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",
    "features": {
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
        "ghcr.io/devcontainers/features/node:2.1.0": {
            "version": "20"
        }
    },
    "postCreateCommand": "pip3 install --user -r requirements.txt",
    "postStartCommand": "sudo npm install -g @anthropic-ai/claude-code",
    "customizations": {
        "extensions": [
            "ms-python.python",
            "ms-python.pylance",
            "ms-toolsai.jupyter"
        ]
    }
}