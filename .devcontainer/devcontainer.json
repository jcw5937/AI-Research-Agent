{
    "name": "AI Research Agent",
    "image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "20"
        }
    },
    "postCreateCommand": "pip3 install --user -r requirements.txt && sudo npm install -g @anthropic-ai/claude-code",
    "customizations": {
        "extensions": [
            "ms-python.python",
            "ms-python.pylance",
            "ms-toolsai.jupyter"
        ]
    }
}